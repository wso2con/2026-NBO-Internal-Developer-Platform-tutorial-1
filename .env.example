# .env.example — Kifaru Bank retail lending demo
#
# Copy to `.env` before `make up`:   cp .env.example .env
# `.env` is gitignored. No secrets belong in Git or in images (BUILD-SPEC.md §2.7).
#
# Every variable below is read by a service via the environment only — no config files,
# no flags (§2.1). The names are the contract with OpenChoreo's dependency injection in
# Phase 2, so they are not renamed to suit a language (§3.2).

# ---------------------------------------------------------------------------
# Postgres container bootstrap
# ---------------------------------------------------------------------------
POSTGRES_USER=kifaru
POSTGRES_PASSWORD=kifaru_local_only
POSTGRES_DB=kifaru

# ---------------------------------------------------------------------------
# Injected by the platform in Phase 2 — set by compose locally
# ---------------------------------------------------------------------------
# In-compose-network addresses. Hostnames here are compose service names, which §2.2
# permits inside a compose file; service code must never hardcode them.
DATABASE_URL=postgres://kifaru:kifaru_local_only@postgres:5432/kifaru?sslmode=disable
NATS_URL=nats://nats:4222
VALKEY_URL=redis://valkey:6379

# loan-api -> credit-scoring endpoint dependency (§7.1)
CREDIT_SCORING_URL=http://credit-scoring:8081
SCORING_TIMEOUT_MS=2000

# disbursement-worker -> external payment provider, via the egress gateway in Phase 2 (§7.3)
# NOTE the port: inside the compose network you reach the CONTAINER port (8080).
# 8082 is the HOST mapping from §9.2, and only works from your laptop.
PAYMENT_RAIL_URL=http://payment-rail-stub:8080
PAYMENT_RAIL_API_KEY=local-dev-key-not-a-real-secret
IDEMPOTENCY_TTL_HOURS=168
ADMIN_PORT=9090

# loan-officer-console — runtime config, never baked into the bundle (§7.5)
API_BASE_URL=http://localhost:8080

# payment-rail-stub failure-path knobs (§7.6)
FAIL_RATE=0
LATENCY_MS=150

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# PORT is deliberately NOT set here — it is per-service, so a single shared value
# would be wrong. Each service gets its own PORT in docker-compose.yml.
#
# Resolved defaults (§2.4 sets the general convention, §7.2 overrides for one service):
#   loan-api         PORT default 8080   (§2.4 general convention)
#   credit-scoring   PORT default 8081   (§7.2 service-specific, and the host port §9.2 reserves)
# The service-specific value wins where the two differ.

# Tracing is a no-op when unset (§3.3). The `observability` compose profile sets it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ---------------------------------------------------------------------------
# Host-side psql, used by demo/local-smoke.sh (§10.1)
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=kifaru
PGPASSWORD=kifaru_local_only
PGDATABASE=kifaru
